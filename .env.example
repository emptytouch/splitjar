# 复制成 .env 后填写。.env 已在 .gitignore 里,不会入库。
#
# ══════════════════════════════════════════════════════════════════
#  ⚠️ 这个文件分成两组,**中间那条线是红线,不是排版**
# ══════════════════════════════════════════════════════════════════
#
#   ① 带 VITE_ 前缀 → 会被 Vite **内联进前端产物**,任何人打开网页就能读到
#   ② 不带前缀     → 只在服务端可见(Vercel Functions)
#
#   **密钥永远归第 ② 组。** 把 `QUOTE_HMAC_SECRET` 写成 `VITE_QUOTE_HMAC_SECRET`
#   等于把签名密钥公开发布 —— 方案 §6.2 的"绝不出现在前端产物"就是这条。
#
#   服务端能读哪些变量,写死在 `server/env.ts` 的登记表里;想加服务端变量
#   必须先去那里登记,否则读不到。这是让上面那条纪律**编译期就拦得住**的办法。


# ══════════════════════════════════════════════════════════════════
#  ① 前端可见(VITE_ 前缀 —— 会被打进 dist,别放任何密钥)
# ══════════════════════════════════════════════════════════════════

# ── WalletConnect ────────────────────────────────────────────────
# 免费申请:https://cloud.walletconnect.com
# 留空也能跑 —— 注入式钱包(Core Wallet / MetaMask)不需要它,
# 只是手机钱包扫码会不可用。
VITE_WALLETCONNECT_PROJECT_ID=

# ── RPC 主备(开发计划 5.2)────────────────────────────────────
# 留空则用代码里的内置默认值。候选端点可用性 9/22 实测后固化。
# ⚠️ 这里只影响"网页自己读链";钱包发交易走钱包内置 RPC。
VITE_RPC_PRIMARY=https://api.avax-test.network/ext/bc/C/rpc
VITE_RPC_BACKUP=https://avalanche-fuji-c-chain-rpc.publicnode.com

# ── CreatorSplitter 合约地址(W2 已部署,2026-09-21)────────────
# 这是**公开信息**(链上人人可查),写在这里当默认值,让 `cp .env.example .env`
# 之后前端直接就能用。重新部署后要改这里,并同步改 Vercel 的 SPLITTER_ADDRESS。
# 部署交易:0x2d7332bb7828671be021f513705b8be2dd285d38aa6aa3900bc8133251552d55
VITE_SPLITTER_ADDRESS=0xDe9b3090263e20ebD5b3795F0199B500f6da72f5


# ══════════════════════════════════════════════════════════════════
#  ② 仅服务端(无前缀 —— 绝不进前端产物)
#
#  这些**不写在这个文件里填**,而是填到 Vercel 项目的 Environment Variables。
#  列在这里是当清单用:本地 `vercel env pull` 会把它拉下来。
#  完整说明见 server/env.ts 的登记表。
# ══════════════════════════════════════════════════════════════════

# ── W6 · 私密内容存储(Vercel Blob)─────────────────────────────
# ⚠️ store 创建时**必须直接选 private** —— 访问模式创建后不可改(风险 R1)
# BLOB_READ_WRITE_TOKEN=

# ── W7 · 402 报价防篡改 ────────────────────────────────────────
# 用 `openssl rand -hex 32` 生成。**这是密钥,永远不要加 VITE_ 前缀**
# QUOTE_HMAC_SECRET=

# ── W7 · 服务端读链(与 ① 组的前端副本是不同的变量名)──────────
# SPLITTER_ADDRESS=
# RPC_PRIMARY=
# RPC_BACKUP=

# ── W8 · 402 报价防重放(Vercel KV)─────────────────────────────
# 接上 KV 后 Vercel 会自动注入这两个,通常不用手填
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── 仅本地用:W2 部署合约 ──────────────────────────────────────
# ⚠️ **绝不写进 .env** —— 这是部署私钥。只在当前 shell export,
#    用完就关窗口。方案 §6.2:私钥仅存环境变量,绝不出现在前端产物或仓库。
# FUJI_RPC_URL=
# DEPLOYER_PRIVATE_KEY=
